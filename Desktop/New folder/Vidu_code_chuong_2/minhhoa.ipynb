    "import json\n",
    "\n",
    "# data là đối tượng Python kiểu từ điển (dict)\n",
    "data = {\n",
    "    \"name\": \"Ng Văn A\",\n",
    "    \"age\": 23,\n",
    "    \"skills\": [\"AI\", \"Python\"]\n",
    "}\n",
    "\n",
    "# Chuyển dict Python sang chuỗi JSON\n",
    "json_str = json.dumps(data, ensure_ascii=False)\n",
    "\n",
    "print(json_str)\n"
   ]
  }
