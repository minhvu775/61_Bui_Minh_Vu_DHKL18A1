    "import json\n",
    "\n",
    "# Dùng chuỗi thô (raw string) để tránh lỗi ký tự thoát (\\)\n",
    "json_str = r'{\"message\": \"Anh ấy nói \\\"Xin chào!\\\"\"}'\n",
    "\n",
    "data = json.loads(json_str)\n",
    "print(data[\"message\"])  # Kết quả: Anh ấy nói \"Xin chào!\"\n"
   ]
  }
